[Unit]
Description=Nobingo Reverb WebSocket Server Daemon
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=2
ExecStart=/usr/bin/php /var/www/nobingo/artisan reverb:start --host=0.0.0.0 --port=8080
StandardOutput=append:/var/log/nobingo/reverb.log
StandardError=append:/var/log/nobingo/reverb-error.log

[Install]
WantedBy=multi-user.target
