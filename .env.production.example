# ==============================================================================
# NOBINGO PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

APP_NAME="Nobingo"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://nobingo.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Strategy: Daily rotating logs with retention
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# Database: MySQL 8.0 with InnoDB and strict multi-tenant constraints
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nobingo_production
DB_USERNAME=nobingo_app
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_DATABASE_PASSWORD
DB_STRICT_MODE=true

# Session Management: High-throughput Redis session storage
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# High-Performance In-Memory Redis Storage
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_TO_A_SECURE_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Caching & Queue: Distributed Redis Engine
CACHE_STORE=redis
CACHE_PREFIX=nobingo_cache_
QUEUE_CONNECTION=redis

# Real-Time WebSocket Infrastructure (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=nobingo-prod-01
REVERB_APP_KEY=CHANGE_ME_REVERB_APP_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_APP_SECRET
REVERB_HOST=nobingo.yourdomain.com
REVERB_PORT=443
REVERB_SCHEME=https

# Frontend Client Echo / Reverb WebSocket Variables
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Filesystem & Cold Storage Backups
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=nobingo-backups-cold-storage

# Mail Configuration (Transactional Notifications)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@nobingo.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security & Password Hashing
BCRYPT_ROUNDS=12
